# GoldSignal configuration — copy this file to .env and fill in values.
# .env is git-ignored. Never commit real credentials.
#
# Set GOLDSIGNAL_DATA_PROVIDER=twelvedata and fill in the TwelveData/
# Telegram/database values below to run against real data (see
# live/run_once.py). Leave it as "mock" (the default) to keep developing
# and testing against fake data only — none of the credentials below are
# required in that case.

# --- Global ---------------------------------------------------------------
GOLDSIGNAL_DATA_PROVIDER=mock
GOLDSIGNAL_INSTRUMENT=XAUUSD
GOLDSIGNAL_LOG_LEVEL=INFO

# Required only when GOLDSIGNAL_DATA_PROVIDER=twelvedata
GOLDSIGNAL_TWELVEDATA_API_KEY=

# Required to actually receive alerts (live/run_once.py warns and skips
# sending if these are blank rather than failing the whole run)
GOLDSIGNAL_TELEGRAM_BOT_TOKEN=
GOLDSIGNAL_TELEGRAM_CHAT_ID=
# When true, also sends NO_TRADE messages (noisy — for debugging only)
GOLDSIGNAL_TELEGRAM_DEBUG_MODE=false

# Neon (or any Postgres) connection string — required by live/run_once.py
GOLDSIGNAL_DATABASE_URL=

# --- Scalp mode: 5m entries confirmed on the 15m chart --------------------
GOLDSIGNAL_SCALP_ENABLED=true
GOLDSIGNAL_SCALP_ENTRY_TIMEFRAME=M5
GOLDSIGNAL_SCALP_CONFIRMATION_TIMEFRAME=M15
GOLDSIGNAL_SCALP_EMA_FAST_PERIOD=20
GOLDSIGNAL_SCALP_EMA_SLOW_PERIOD=50
GOLDSIGNAL_SCALP_RSI_PERIOD=14
GOLDSIGNAL_SCALP_RSI_BUY_THRESHOLD=50
GOLDSIGNAL_SCALP_RSI_SELL_THRESHOLD=50
GOLDSIGNAL_SCALP_RSI_OVERBOUGHT=70
GOLDSIGNAL_SCALP_RSI_OVERSOLD=30
GOLDSIGNAL_SCALP_ATR_PERIOD=14
GOLDSIGNAL_SCALP_ATR_STOP_MULTIPLIER=1.2
GOLDSIGNAL_SCALP_STRUCTURE_LOOKBACK=20
GOLDSIGNAL_SCALP_RETEST_TOLERANCE_ATR_FRACTION=0.25
GOLDSIGNAL_SCALP_RETEST_CONFIRM_WINDOW=5
GOLDSIGNAL_SCALP_CHOP_FILTER_ATR_MULTIPLE=0.5
GOLDSIGNAL_SCALP_TREND_STRENGTH_ATR_MULTIPLE=1.5
GOLDSIGNAL_SCALP_MIN_NET_REWARD_R=1.0
GOLDSIGNAL_SCALP_ESTIMATED_SPREAD=0.30
GOLDSIGNAL_SCALP_ESTIMATED_SLIPPAGE=0.20
GOLDSIGNAL_SCALP_ESTIMATED_TRANSACTION_COST=0.0
GOLDSIGNAL_SCALP_COOLDOWN_MINUTES=15
GOLDSIGNAL_SCALP_MAX_SIGNALS_PER_SESSION=6
GOLDSIGNAL_SCALP_SETUP_EXPIRATION_CANDLES=3
GOLDSIGNAL_SCALP_TRADE_MANAGEMENT_PRESET=balanced
GOLDSIGNAL_SCALP_TP_SHORTFALL_HANDLING=normalize
GOLDSIGNAL_SCALP_BREAKEVEN_TRIGGER=none
GOLDSIGNAL_SCALP_BREAKEVEN_AFTER_R_MULTIPLE=

# --- Day-trade mode: 15m entries confirmed on the 1h chart -----------------
GOLDSIGNAL_DAYTRADE_ENABLED=true
GOLDSIGNAL_DAYTRADE_ENTRY_TIMEFRAME=M15
GOLDSIGNAL_DAYTRADE_CONFIRMATION_TIMEFRAME=H1
GOLDSIGNAL_DAYTRADE_EMA_FAST_PERIOD=20
GOLDSIGNAL_DAYTRADE_EMA_SLOW_PERIOD=50
GOLDSIGNAL_DAYTRADE_RSI_PERIOD=14
GOLDSIGNAL_DAYTRADE_RSI_BUY_THRESHOLD=50
GOLDSIGNAL_DAYTRADE_RSI_SELL_THRESHOLD=50
GOLDSIGNAL_DAYTRADE_RSI_OVERBOUGHT=70
GOLDSIGNAL_DAYTRADE_RSI_OVERSOLD=30
GOLDSIGNAL_DAYTRADE_ATR_PERIOD=14
GOLDSIGNAL_DAYTRADE_ATR_STOP_MULTIPLIER=1.5
GOLDSIGNAL_DAYTRADE_STRUCTURE_LOOKBACK=20
GOLDSIGNAL_DAYTRADE_RETEST_TOLERANCE_ATR_FRACTION=0.25
GOLDSIGNAL_DAYTRADE_RETEST_CONFIRM_WINDOW=5
GOLDSIGNAL_DAYTRADE_CHOP_FILTER_ATR_MULTIPLE=0.5
GOLDSIGNAL_DAYTRADE_TREND_STRENGTH_ATR_MULTIPLE=1.5
GOLDSIGNAL_DAYTRADE_MIN_NET_REWARD_R=2.0
GOLDSIGNAL_DAYTRADE_ESTIMATED_SPREAD=0.30
GOLDSIGNAL_DAYTRADE_ESTIMATED_SLIPPAGE=0.20
GOLDSIGNAL_DAYTRADE_ESTIMATED_TRANSACTION_COST=0.0
GOLDSIGNAL_DAYTRADE_COOLDOWN_MINUTES=60
GOLDSIGNAL_DAYTRADE_MAX_SIGNALS_PER_SESSION=4
GOLDSIGNAL_DAYTRADE_SETUP_EXPIRATION_CANDLES=3
GOLDSIGNAL_DAYTRADE_TRADE_MANAGEMENT_PRESET=balanced
GOLDSIGNAL_DAYTRADE_TP_SHORTFALL_HANDLING=normalize
GOLDSIGNAL_DAYTRADE_BREAKEVEN_TRIGGER=none
GOLDSIGNAL_DAYTRADE_BREAKEVEN_AFTER_R_MULTIPLE=
